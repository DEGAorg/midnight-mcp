{
  "include": ["src/**/*.ts"],
  "compilerOptions": {
    "outDir": "dist",
    "declaration": true,
    "lib": ["ESNext"],
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "node",
    "allowJs": true,
    "forceConsistentCasingInFileNames": true,
    "noImplicitAny": true,
    "strict": true,
    "isolatedModules": true,
    "sourceMap": true,
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "baseUrl": ".",
    "types": ["jest", "node"],
    "allowSyntheticDefaultImports": true,
    "paths": {
      "@services/*": ["src/services/*"],
      "@lib/*": ["src/lib/*"],
      "@mcp/*": ["src/mcp/*"],
      "@contracts/*": ["src/contracts/*"],
      "@api/*": ["src/api/*"],
      "@agents/*": ["src/agents/*"],
      "@audit/*": ["src/audit/*"],
      "@shared/*": ["src/types/*"]
    }
  },
  "exclude": [
    "node_modules",
    "dist",
    "src/_wallet/**",
    "src/audit/integration-example.ts",
    "src/audit/example-usage.ts"
  ]
} 