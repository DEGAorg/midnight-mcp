# Dependencies
node_modules/
pnpm-lock.yaml
package-lock.json

# Build output
dist/
build/
*.js
*.js.map
*.d.ts
*.d.ts.map

# But keep the compiled dist for production
!dist/.gitkeep

# Environment variables
.env
.env.local
.env.*.local

# IDE
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store

# Logs
logs/
*.log
npm-debug.log*
pnpm-debug.log*
yarn-debug.log*
yarn-error.log*

# Testing
coverage/
.nyc_output/

# Temporary files
tmp/
temp/
*.tmp

# Storage data (contains private keys!)
# Allow src/storage/ (source code) but ignore root-level storage data
/storage/
/data/
!storage/.gitkeep

# OS
Thumbs.db
.DS_Store

# Yarn 2+ (Berry) - cache files
.yarn/cache/
.yarn/install-state.gz
.yarn/unplugged/
.yarn/build-state.yml
.pnp.*
