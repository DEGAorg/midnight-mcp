{
  "name": "identus-mcp",
  "version": "1.0.0",
  "description": "Hyperledger Identus MCP Server - DID Management for Midnight City Agents",
  "packageManager": "yarn@4.1.0",
  "type": "module",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx src/server.ts",
    "build": "tsc",
    "clean": "rm -rf dist",
    "start": "node dist/server.js",
    "test": "tsx src/tools/test-tools.ts",
    "lint": "eslint src --ext .ts",
    "lint:fix": "eslint src --ext .ts --fix"
  },
  "keywords": [
    "identus",
    "hyperledger",
    "did",
    "verifiable-credentials",
    "mcp",
    "model-context-protocol"
  ],
  "author": "DEGA Team",
  "license": "MIT",
  "dependencies": {
    "@hyperledger/identus-sdk": "^7.0.0",
    "@modelcontextprotocol/sdk": "^0.5.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@typescript-eslint/eslint-plugin": "^6.19.0",
    "@typescript-eslint/parser": "^6.19.0",
    "eslint": "^8.56.0",
    "tsx": "^4.7.0",
    "typescript": "^5.3.0"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
