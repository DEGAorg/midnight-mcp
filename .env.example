# Midnight MCP Server Environment Variables
# Copy this file to .env for local development

# ===== REQUIRED CONFIGURATION =====

# Agent identifier (required)
# Each agent gets isolated storage in .storage/seeds/{AGENT_ID}/
AGENT_ID=my-agent

# ===== NETWORK CONFIGURATION =====

# Network ID (default: TestNet)
# Options: MainNet, TestNet, DevNet
NETWORK_ID=TestNet

# Network endpoints (default to TestNet if not specified)
# Proof server URL (default: http://127.0.0.1:6300)
PROOF_SERVER=http://localhost:6300

# Indexer GraphQL endpoint (default: TestNet indexer)
INDEXER=https://indexer.testnet-02.midnight.network/api/v1/graphql

# Indexer WebSocket endpoint (default: TestNet indexer WS)
INDEXER_WS=wss://indexer.testnet-02.midnight.network/api/v1/graphql/ws

# Midnight node RPC endpoint (default: TestNet RPC)
MN_NODE=https://rpc.testnet-02.midnight.network

# ===== STORAGE CONFIGURATION =====

# Base storage directory (default: .storage)
# All agent data is stored under this directory
BASE_STORAGE_DIR=.storage

# Wallet backup folder (default: .storage/wallet-backups)
# Wallet state files are saved here
WALLET_BACKUP_FOLDER=.storage/wallet-backups

# Wallet filename (default: midnight-wallet)
WALLET_FILENAME=midnight-wallet

# ===== CONTRACT CONFIGURATION (OPTIONAL) =====

# DAO contract address (optional)
# Required to enable DAO tools: openDaoElection, castDaoVote, closeDaoElection, fundDaoTreasury
# DAO_CONTRACT_ADDRESS=0x1234567890abcdef1234567890abcdef12345678

# Marketplace contract address (optional)
# Required to enable Marketplace tools: getUserInfo, isUserRegistered, isUserVerified
# MARKETPLACE_CONTRACT_ADDRESS=0xfedcba0987654321fedcba0987654321fedcba09

# ===== SERVER CONFIGURATION =====

# API server port (default: 3000)
# Used for REST API mode (yarn start:api)
API_PORT=3000

# HTTP MCP server port (used by yarn start:mcp:http, not yarn start)
# SERVER_PORT=3001

# Legacy wallet server configuration (not used by new architecture)
# WALLET_SERVER_HOST=localhost
# WALLET_SERVER_PORT=3000

# ===== FEATURE FLAGS =====

# Enable REST API server (default: true)
ENABLE_API=true

# Enable MCP server (default: true)
ENABLE_MCP=true

# Legacy external proof server flag (no longer used, endpoints have defaults)
# USE_EXTERNAL_PROOF_SERVER=true

# ===== LOGGING CONFIGURATION =====

# Log level (default: info)
# Options: error, warn, info, debug, trace
LOG_LEVEL=info